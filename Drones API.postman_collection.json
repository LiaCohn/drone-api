{
  "info": {
    "_postman_id": "6ae9efcf-6be4-465f-9015-b7532f0c8f75",
    "name": "Drones API",
    "description": "Requests for the current Drone API routes. For an end-to-end scheduler test, create a drone and mission, then create a pending schedule whose start time is in the past. The scheduler checks on startup and every 2 minutes and sends a desktop notification when it dispatches the mission. Collection variables can be edited before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Drones",
      "item": [
        {
          "name": "Create drone",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.collectionVariables.set('droneId', String(runId));",
                  "pm.collectionVariables.set('missionId', String(runId + 1));",
                  "pm.collectionVariables.set('scheduleId', String(runId + 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{droneId}},\n  \"name\": \"Test Drone\",\n  \"status\": \"available\",\n  \"possible_missions_ids\": [{{missionId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/drones/"
          },
          "response": []
        },
        {
          "name": "List all drones",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/drones/"
          },
          "response": []
        },
        {
          "name": "Get drone by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/drones/{{droneId}}"
          },
          "response": []
        },
        {
          "name": "List drones by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/drones/status/{{droneStatus}}"
          },
          "response": []
        },
        {
          "name": "Update drone status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/drones/{{droneId}}"
          },
          "response": []
        },
        {
          "name": "Update drone possible missions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"possible_missions_ids\": [{{missionId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/drones/{{droneId}}/possible_missions"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Missions",
      "item": [
        {
          "name": "Create mission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{missionId}},\n  \"trajectory_id\": 3,\n  \"duration\": 45,\n  \"priority\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/missions/"
          },
          "response": []
        },
        {
          "name": "List all missions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/missions/"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create due schedule (triggers mission and notification)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('scheduleStartTime', new Date(Date.now() - 60000).toISOString());",
                  "pm.collectionVariables.set('scheduleEndTime', new Date(Date.now() + 86400000).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{scheduleId}},\n  \"drone_id\": {{droneId}},\n  \"mission_id\": {{missionId}},\n  \"start_time\": \"{{scheduleStartTime}}\",\n  \"end_time\": \"{{scheduleEndTime}}\",\n  \"status\": \"pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/schedules/"
          },
          "response": []
        },
        {
          "name": "List all schedules",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/schedules/"
          },
          "response": []
        },
        {
          "name": "List schedules by drone ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/schedules/{{droneId}}"
          },
          "response": []
        },
        {
          "name": "List schedules by date range",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('rangeStart', new Date(Date.now() - 86400000).toISOString());",
                  "pm.collectionVariables.set('rangeEnd', new Date(Date.now() + 172800000).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/schedules/{{rangeStart}}/{{rangeEnd}}"
          },
          "response": []
        },
        {
          "name": "Update schedule status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/schedules/{{scheduleId}}"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "droneId",
      "value": "9001"
    },
    {
      "key": "missionId",
      "value": "9002"
    },
    {
      "key": "scheduleId",
      "value": "9003"
    },
    {
      "key": "droneStatus",
      "value": "available"
    },
    {
      "key": "scheduleStartTime",
      "value": ""
    },
    {
      "key": "scheduleEndTime",
      "value": ""
    },
    {
      "key": "rangeStart",
      "value": ""
    },
    {
      "key": "rangeEnd",
      "value": ""
    }
  ]
}
